        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "artifact_id"
      ],
      "additionalProperties": false
    },
    "analysis_interest_release": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "symbol",
                "file",
                "candidate",
                "artifact"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "filters": {
          "type": "object",
          "properties": {
            "result_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64
            },
            "include_superseded": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "subject",
        "filters"
      ],
      "additionalProperties": false
    },
    "report_lead": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 1,
          "maxItems": 64
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "symbol",
                  "file",
                  "candidate",
                  "artifact"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 64
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 0,
          "maxItems": 64
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 0,
          "maxItems": 64
        },
        "requested_check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "hypothesis",
        "observations",
        "subject_refs",
        "unknowns",
        "requested_check"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "evidence_refs": {
              "minItems": 1
            }
          },
          "required": [
            "evidence_refs"
          ]
        },
        {
          "properties": {
            "source_refs": {
              "minItems": 1
            }
          },
          "required": [
            "source_refs"
          ]
        }
      ]
    },
