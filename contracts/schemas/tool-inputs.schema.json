  "$defs": {
    "source_read": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "symbol_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "symbol_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file_id",
            "start_line",
            "end_line"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "cursor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "symbol_get": {
      "type": "object",
      "properties": {
        "symbol_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "symbol_id"
      ],
      "additionalProperties": false
    },
    "source_stat": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "file_id"
      ],
      "additionalProperties": false
    },
    "symbol_list": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "local_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "qualified_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "parent_symbol_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [],
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "file_id",
                  "path"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "local_name",
                  "qualified_name"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "cursor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "file_list": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "BROWSE"
            },
            "directory": {
              "type": "string",
              "maxLength": 4096
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "mode",
            "directory"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "FIND"
            },
            "filename": {
              "type": "string",
              "maxLength": 4096
            },
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "directory": {
              "type": "string",
              "maxLength": 4096
            },
            "recursive": {
              "type": "boolean"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64
            },
            "classifications": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "not": {
            "required": [
              "filename",
              "path"
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "cursor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "relationship_query": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "symbol_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1,
              "maxItems": 32
            },
            "direction": {
              "enum": [
                "IN",
                "OUT",
                "BOTH"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "symbol_id",
            "kinds",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "cursor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source_search": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "enum": [
            "LITERAL",
            "REGEX"
          ],
          "default": "LITERAL"
        },
        "flags": {
          "type": "object",
          "properties": {
            "case_sensitive": {
              "type": "boolean",
              "default": true
            },
            "multiline": {
              "type": "boolean",
              "default": false
            },
            "dotall": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "selection": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "FILES"
                },
                "file_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "file_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "DIRECTORY"
                },
                "directory": {
                  "type": "string",
                  "maxLength": 4096
                },
                "recursive": {
                  "type": "boolean"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "classifications": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 64
                }
              },
              "required": [
                "kind",
                "directory",
                "recursive"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "SNAPSHOT"
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "classifications": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 64
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query",
        "selection"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "mode": {
                    "const": "LITERAL"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              {
                "not": {
                  "required": [
                    "mode"
                  ]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "flags": {
                "properties": {
                  "multiline": {
                    "const": false
                  },
                  "dotall": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "document_query": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "symbol",
                    "file",
                    "candidate",
                    "artifact"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "result_kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 64
            },
            "include_superseded": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "subject"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "cursor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "analysis_get": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
